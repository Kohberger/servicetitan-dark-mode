{
  "manifest_version": 3,
  "name": "ServiceTitan Dark Mode By BCN",
  "description": "Dynamic dark mode for ServiceTitan, plus an optional cleaner look for invoices, batching and job history. Made By Blue Collar Nerd",
  "version": "1.4",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.servicetitan.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ServiceTitan Dark (Dynamic)"
  },
  "commands": {
    "toggle-dark": {
      "suggested_key": {
        "default": "Alt+D"
      },
      "description": "Toggle ServiceTitan dark mode for this host"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.servicetitan.com/*"
      ],
      "js": [
        "engine.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN",
      "exclude_matches": [
        "*://help.servicetitan.com/*"
      ]
    },
    {
      "matches": [
        "*://*.servicetitan.com/*"
      ],
      "js": [
        "toggle-core.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "exclude_matches": [
        "*://help.servicetitan.com/*"
      ]
    },
    {
      "matches": [
        "*://*.servicetitan.com/*"
      ],
      "js": [
        "features/beautify/beautify.js",
        "features/beautify/runtime.js",
        "features/beautify/invoice-header.js",
        "features/beautify/invoice.js",
        "features/beautify/job-audit.js",
        "features/beautify/batching.js"
      ],
      "css": [
        "features/beautify/beautify.css",
        "features/beautify/batching.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "exclude_matches": [
        "*://help.servicetitan.com/*"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/guide.jpg"
      ],
      "matches": [
        "*://*.servicetitan.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
